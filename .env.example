PORT=8080

# Data source: currently optimized for CTFtime.
CTF_PROVIDER=ctftime
CTF_API_BASE_URL=https://ctftime.org/api/v1
CTF_USER_AGENT=Mozilla/5.0 (CTF-Live-Viewer)

# Optional upstream API key settings.
# If your source requires key auth, set these.
CTF_API_KEY=
CTF_API_KEY_HEADER=Authorization
CTF_API_KEY_PREFIX=Bearer
CTF_API_KEY_QUERY=

# Polling and range
CTF_REFRESH_MS=45000
CTF_LOOKAHEAD_DAYS=120
CTF_EVENTS_LIMIT=200
